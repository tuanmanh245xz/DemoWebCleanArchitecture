@model Demo.Web.Models.User.DeleteUserViewModel

<h1>Xoa san pham</h1>

@if (ViewBag.ErrorMessage != null)
{
    <p style="color: red">@ViewBag.ErrorMessage</p>
}

<p>Ban co chac muon xoa san pham nay khong?</p>

<p>Ma: @Model.Id</p>
<p>Ten: @Model.UserName</p>

<form asp-controller="User" asp-action="Delete" method="post">
    <input asp-for="Id" type="hidden" />
    <input asp-for="UserName" type="hidden" />

    <button type="submit">Xoa</button>
</form>

<p>
    <a asp-controller="User" asp-action="Index">Quay lai</a>
</p>